{
  "name": "@pantry/price-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Price refresh: StatCan import, hand-entry CSV, and the weekly store collector (Walmart, Giant Tiger). Produces data only.",
  "type": "module",
  "scripts": {
    "import": "tsx src/import.ts",
    "template": "tsx src/template.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "find": "tsx src/find.ts",
    "pick": "tsx src/pick.ts",
    "weekly": "PRICE_SOURCES=statcan,statcan_provinces,manual,walmart_ca,gianttiger_ca tsx src/import.ts"
  },
  "dependencies": {
    "@pantry/pricing": "*",
    "@pantry/vocabulary": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
